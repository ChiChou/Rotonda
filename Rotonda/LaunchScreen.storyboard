                            <constraint firstItem="rome" firstAttribute="bottom" secondItem="launch-view" secondAttribute="bottom" constant="0" id="rome-bottom"/>
                            <constraint firstItem="rome" firstAttribute="width" secondItem="launch-view" secondAttribute="width" multiplier="0.5" priority="999" id="rome-width"/>
                            <constraint firstItem="rome" firstAttribute="width" relation="lessThanOrEqual" constant="540" id="rome-max-width"/>
                            <constraint firstItem="rome" firstAttribute="height" secondItem="rome" secondAttribute="width" id="rome-aspect"/>
                            <constraint firstItem="rome" firstAttribute="height" relation="lessThanOrEqual" secondItem="launch-view" secondAttribute="height" multiplier="0.44" id="rome-max-height"/>

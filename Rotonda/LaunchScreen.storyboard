                                <rect key="frame" x="204.5" y="713" width="196.5" height="131"/>
                                <color key="tintColor" name="LaunchSketchInk"/>
                                <accessibility key="accessibilityConfiguration" identifier="coast"><bool key="isElement" value="NO"/></accessibility>

  "rows": [
    {
      "number": 35611,
      "text": "Le uscite sono distribuite equamente sui due lati, così da offrire vie di fuga su entrambi. La disposizione riguarda il complesso delle uscite, non necessariamente un numero identico di sole uscite di emergenza per lato.",
      "evidence": [
        "Regolamento UNECE n. 107 (2018/237), https://eur-lex.europa.eu/legal-content/IT/TXT/?uri=CELEX%3A42018X0237, punto 7.6.2.3, distribuzione delle uscite sui due lati"
      ]
    },
    {
      "number": 35613,
      "text": "Non tutte le uscite di emergenza devono coincidere con porte di servizio: il regolamento distingue le porte di accesso dalle porte di sicurezza.",
      "evidence": [
        "Regolamento UNECE n. 107 (2018/237), https://eur-lex.europa.eu/legal-content/IT/TXT/?uri=CELEX%3A42018X0237, punto 7.6.1.1, previsione distinta di porta di accesso e porta di sicurezza"
      ]
    },
    {
      "number": 35615,
      "text": "Non devono trovarsi tutte a destra: le uscite sono distribuite sui due lati del veicolo.",
      "evidence": [
        "Regolamento UNECE n. 107 (2018/237), https://eur-lex.europa.eu/legal-content/IT/TXT/?uri=CELEX%3A42018X0237, punto 7.6.2.3, distribuzione delle uscite sui due lati"
      ]
    },
    {
      "number": 35619,
      "text": "Il numero minimo di uscite dipende dalla capacità del vano o del piano. La tabella considera anche l'eventuale personale di servizio, oltre ai passeggeri.",
      "evidence": [
        "Regolamento UNECE n. 107 (2018/237), https://eur-lex.europa.eu/legal-content/IT/TXT/?uri=CELEX%3A42018X0237, punto 7.6.1.4, numero minimo totale di uscite secondo la capienza"
      ]
    },
    {
      "number": 35623,
      "text": "Non è la massa a pieno carico a determinare il minimo: la tabella usa la capienza di passeggeri e personale di servizio del vano o del piano.",
      "evidence": [
        "Regolamento UNECE n. 107 (2018/237), https://eur-lex.europa.eu/legal-content/IT/TXT/?uri=CELEX%3A42018X0237, punto 7.6.1.4, numero minimo totale di uscite secondo la capienza"
      ]
    },
    {
      "number": 35627,
      "text": "Non coincidono sempre: oltre alle porte di accesso possono essere previste porte di sicurezza distinte.",
      "evidence": [
        "Regolamento UNECE n. 107 (2018/237), https://eur-lex.europa.eu/legal-content/IT/TXT/?uri=CELEX%3A42018X0237, punto 7.6.1.1, previsione distinta di porta di accesso e porta di sicurezza"
      ]
    },
    {
      "number": 35630,
      "text": "Il minimo è legato alla capienza del vano o del piano; la tabella considera anche l'eventuale personale di servizio.",
      "evidence": [
        "Regolamento UNECE n. 107 (2018/237), https://eur-lex.europa.eu/legal-content/IT/TXT/?uri=CELEX%3A42018X0237, punto 7.6.1.4, numero minimo totale di uscite secondo la capienza"
      ]
    }
